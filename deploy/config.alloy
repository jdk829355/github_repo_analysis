// 이 프로젝트의 컨테이너 로그를 읽어 Grafana Cloud Loki로 보낸다.
// 같은 서버의 다른 컨테이너 로그가 밖으로 나가지 않도록 compose 프로젝트로 거른다.
discovery.docker "project" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=github_repo_analysis"]
	}
}

discovery.relabel "container_name" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "project" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.project.targets
	relabel_rules = discovery.relabel.container_name.rules
	forward_to    = [loki.process.level.receiver]
}

// jobId, repo처럼 값이 계속 늘어나는 필드는 레이블로 만들지 않는다. level만 올린다.
loki.process "level" {
	forward_to = [loki.write.grafana_cloud.receiver]

	stage.json {
		expressions = {level = "level"}
	}

	stage.labels {
		values = {level = ""}
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}
