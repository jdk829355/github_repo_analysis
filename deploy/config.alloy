// 이 프로젝트의 컨테이너 로그를 읽어 Grafana Cloud Loki로 보낸다.
// 같은 서버의 다른 컨테이너 로그가 밖으로 나가지 않도록 compose 프로젝트로 거른다.
discovery.docker "project" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=github_repo_analysis"]
	}
}

discovery.relabel "container_name" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "project" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.project.targets
	relabel_rules = discovery.relabel.container_name.rules
	forward_to    = [loki.process.level.receiver]
}

// jobId, repo처럼 값이 계속 늘어나는 필드는 레이블로 만들지 않는다. level만 올린다.
loki.process "level" {
	forward_to = [loki.write.grafana_cloud.receiver]

	stage.json {
		expressions = {level = "level"}
	}

	stage.labels {
		values = {level = ""}
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}

// 서버 CPU·메모리·디스크. 컨테이너 안에서 돌기 때문에 호스트 경로를 마운트한 곳에서 읽는다.
prometheus.exporter.unix "server" {
	rootfs_path = "/rootfs"
	procfs_path = "/host/proc"
}

// 컨테이너별 사용량.
prometheus.exporter.cadvisor "containers" {
	docker_host            = "unix:///var/run/docker.sock"
	docker_only            = true
	store_container_labels = false
}

prometheus.scrape "metrics" {
	targets    = array.concat(prometheus.exporter.unix.server.targets, prometheus.exporter.cadvisor.containers.targets)
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}
